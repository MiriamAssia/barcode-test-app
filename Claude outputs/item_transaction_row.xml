<?xml version="1.0" encoding="utf-8"?>
<!-- שורת תנועה בהיסטוריית הפריט: סוג, כמות, מתי, סיבה ומי ביצע -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/md_unit"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/md_margin_mobile">

    <TextView
        android:id="@+id/txQuantity"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textDirection="ltr"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MedTrack.BodyMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>
