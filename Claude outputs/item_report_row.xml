<?xml version="1.0" encoding="utf-8"?>
<!--
    שורה בדוח הצריכה. הפס מתחת לשם מראה את חלקו היחסי של הפריט בסך
    הצריכה, כדי שאפשר יהיה לזהות בסריקה מהירה מה "שורף" הכי הרבה.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/md_margin_mobile">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reportName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.MedTrack.BodyLarge"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reportShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/md_unit"
            android:textColor="@color/md_on_surface_variant"
            android:textDirection="ltr"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/reportAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/md_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!--
        הפס בנוי משני חלקים במשקלים משלימים, כדי שהיחס ייקבע בזמן הפריסה
        ולא ידרוש חישוב רוחב בפיקסלים.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_report_bar_track"
        android:orientation="horizontal">

        <View
            android:id="@+id/reportBarFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_report_bar" />

        <View
            android:id="@+id/reportBarRest"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
