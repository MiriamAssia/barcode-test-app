<?xml version="1.0" encoding="utf-8"?>
<!-- חלון בחירת כמות, נפתח בלחיצה ארוכה על שורת פריט -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/md_gutter"
    android:paddingTop="@dimen/md_margin_mobile"
    android:paddingEnd="@dimen/md_gutter"
    android:paddingBottom="@dimen/md_unit">

    <TextView
        android:id="@+id/quantityItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="@dimen/md_margin_mobile"
        android:textAppearance="@style/TextAppearance.MedTrack.BodyLarge"
        android:textColor="@color/md_on_surface_variant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/md_touch_target_min"
        android:background="@drawable/bg_input"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/quantityMinus"
            android:layout_width="@dimen/md_touch_target_min"
            android:layout_height="match_parent"
            android:background="@drawable/bg_stepper_button"
            android:contentDescription="@string/cd_decrease"
            android:padding="@dimen/md_margin_mobile"
            android:src="@drawable/ic_remove"
            app:tint="@color/md_on_surface" />

        <EditText
            android:id="@+id/quantityInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:text="1"
            android:textColor="@color/md_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/quantityPlus"
            android:layout_width="@dimen/md_touch_target_min"
            android:layout_height="match_parent"
            android:background="@drawable/bg_stepper_button"
            android:contentDescription="@string/cd_increase"
            android:padding="@dimen/md_margin_mobile"
            android:src="@drawable/ic_add"
            app:tint="@color/md_on_surface" />

    </LinearLayout>

</LinearLayout>
