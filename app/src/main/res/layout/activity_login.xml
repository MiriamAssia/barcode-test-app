<?xml version="1.0" encoding="utf-8"?>
<!--
    מסך התחברות, על אותה מערכת עיצוב כמו שאר האפליקציה: אותה פלטה, אותם
    שדות קלט מעוגלים, ואותו כפתור פעולה ראשי.

    המסך ממורכז אנכית ונגלל, כדי שכשהמקלדת נפתחת בטלפון הטופס יעלה למעלה
    במקום להיחתך.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/md_gutter"
        android:paddingTop="@dimen/md_gutter"
        android:paddingEnd="@dimen/md_gutter"
        android:paddingBottom="@dimen/md_gutter">

        <!-- ===================== סמל וכותרת ===================== -->
        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_logo_circle"
            android:contentDescription="@string/cd_app_logo"
            android:padding="20dp"
            android:src="@drawable/ic_inventory"
            app:tint="@color/md_tertiary" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/md_gutter"
            android:gravity="center"
            android:text="@string/login_title"
            android:textAppearance="@style/TextAppearance.MedTrack.HeadlineLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/md_unit"
            android:gravity="center"
            android:text="@string/login_subtitle"
            android:textAppearance="@style/TextAppearance.MedTrack.BodyLarge"
            android:textColor="@color/md_on_surface_variant" />

        <!-- ===================== טופס ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/md_gutter">

            <TextView
                style="@style/Widget.MedTrack.FieldLabel"
                android:text="@string/login_email_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/md_touch_target_min"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/md_unit"
                android:paddingEnd="@dimen/md_unit">

                <EditText
                    android:id="@+id/emailInput"
                    style="@style/Widget.MedTrack.EditText"
                    android:autofillHints="username"
                    android:hint="@string/login_email_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:textDirection="ltr" />

            </LinearLayout>

            <TextView
                style="@style/Widget.MedTrack.FieldLabel"
                android:layout_marginTop="@dimen/md_margin_mobile"
                android:text="@string/login_password_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/md_touch_target_min"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/md_unit"
                android:paddingEnd="@dimen/md_unit">

                <EditText
                    android:id="@+id/passwordInput"
                    style="@style/Widget.MedTrack.EditText"
                    android:autofillHints="password"
                    android:hint="@string/login_password_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:textDirection="ltr" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginButton"
                style="@style/Widget.MedTrack.Button.Primary"
                android:layout_marginTop="@dimen/md_gutter"
                android:text="@string/login_action" />

            <ProgressBar
                android:id="@+id/loadingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/md_margin_mobile"
                android:visibility="gone" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_margin_mobile"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.MedTrack.BodyMedium"
                android:textColor="@color/md_error" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
