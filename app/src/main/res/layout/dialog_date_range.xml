<?xml version="1.0" encoding="utf-8"?>
<!-- בחירת טווח תאריכים ידנית לדוח הצריכה, נפתח מהצ'יפ "טווח אחר" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/md_gutter"
    android:paddingTop="@dimen/md_margin_mobile"
    android:paddingEnd="@dimen/md_gutter"
    android:paddingBottom="@dimen/md_unit">

    <TextView
        android:id="@+id/dateRangeError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/md_margin_mobile"
        android:textColor="@color/md_error"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        style="@style/Widget.MedTrack.FieldLabel"
        android:text="@string/reports_range_from" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/md_touch_target_min"
        android:layout_marginBottom="@dimen/md_margin_mobile"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/md_margin_mobile"
        android:paddingEnd="@dimen/md_margin_mobile">

        <com.miriam.barcodetest.ui.DateInputView
            android:id="@+id/rangeFromInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <TextView
        style="@style/Widget.MedTrack.FieldLabel"
        android:text="@string/reports_range_to" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/md_touch_target_min"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/md_margin_mobile"
        android:paddingEnd="@dimen/md_margin_mobile">

        <com.miriam.barcodetest.ui.DateInputView
            android:id="@+id/rangeToInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
