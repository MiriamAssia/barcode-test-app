<?xml version="1.0" encoding="utf-8"?>
<!--
    מסך זמני לטאבים שעדיין לא נבנו (הוצאת מלאי, רשימת מלאי, התראות, דוחות).
    כל אחד מהם יוחלף במסך אמיתי בשלב הייעודי לו. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/md_gutter">

    <ImageView
        android:id="@+id/placeholderIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:alpha="0.4"
        android:contentDescription="@null"
        android:src="@drawable/ic_inventory"
        app:tint="@color/md_on_surface_variant" />

    <TextView
        android:id="@+id/placeholderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/md_margin_mobile"
        android:textAppearance="@style/TextAppearance.MedTrack.HeadlineMedium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/md_unit"
        android:text="@string/coming_soon"
        android:textAppearance="@style/TextAppearance.MedTrack.BodyMedium"
        android:textColor="@color/md_on_surface_variant" />

</LinearLayout>
