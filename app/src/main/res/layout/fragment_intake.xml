<?xml version="1.0" encoding="utf-8"?>
<!--
    מסך קליטת מלאי - מבוסס על העיצוב מ-Stitch (MedTrack Dark).
    שני מסלולים: סריקת ברקוד למעלה, או הזנה ידנית של מק"ט בטופס למטה. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/md_margin_mobile"
        android:paddingTop="@dimen/md_margin_mobile"
        android:paddingEnd="@dimen/md_margin_mobile"
        android:paddingBottom="@dimen/md_gutter">

        <!-- ===================== כותרת משנה ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="@dimen/md_unit"
            android:paddingEnd="@dimen/md_unit"
            android:paddingBottom="@dimen/md_gutter"
            android:text="@string/intake_subtitle"
            android:textAppearance="@style/TextAppearance.MedTrack.BodyLarge"
            android:textColor="@color/md_on_surface_variant" />

        <!-- ===================== כרטיס סריקה ===================== -->
        <LinearLayout
            android:id="@+id/scanCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/md_touch_target_min"
            android:orientation="horizontal"
            android:padding="@dimen/md_margin_mobile">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/intake_scan_action"
                android:textAppearance="@style/TextAppearance.MedTrack.BodyLarge" />

            <ImageView
                android:layout_width="@dimen/md_icon_lg"
                android:layout_height="@dimen/md_icon_lg"
                android:contentDescription="@string/cd_scan"
                android:src="@drawable/ic_qr_code_scanner"
                app:tint="@color/md_tertiary" />

        </LinearLayout>

        <!-- ===================== מפריד "או" ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/md_gutter"
            android:paddingBottom="@dimen/md_gutter">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/md_outline_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/md_margin_mobile"
                android:paddingEnd="@dimen/md_margin_mobile"
                android:text="@string/intake_or"
                android:textAppearance="@style/TextAppearance.MedTrack.BodyMedium"
                android:textColor="@color/md_on_surface_variant" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/md_outline_variant" />

        </LinearLayout>

        <!-- ===================== טופס הקליטה ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/md_gutter">

            <!--  מק"ט / ברקוד -->
            <TextView
                style="@style/Widget.MedTrack.FieldLabel"
                android:text="@string/intake_barcode_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/md_touch_target_min"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/md_margin_mobile"
                android:paddingEnd="@dimen/md_unit">

                <ImageView
                    android:layout_width="@dimen/md_icon_md"
                    android:layout_height="@dimen/md_icon_md"
                    android:contentDescription="@string/cd_search"
                    android:src="@drawable/ic_search"
                    app:tint="@color/md_outline" />

                <EditText
                    android:id="@+id/barcodeInput"
                    style="@style/Widget.MedTrack.EditText"
                    android:hint="@string/intake_barcode_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <ProgressBar
                    android:id="@+id/lookupProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!--  חיווי הפריט שנמצא / לא נמצא -->
            <LinearLayout
                android:id="@+id/resultStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_unit"
                android:background="@drawable/bg_result_ok"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="@dimen/md_unit"
                android:paddingBottom="@dimen/md_unit"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/resultIcon"
                    android:layout_width="@dimen/md_icon_md"
                    android:layout_height="@dimen/md_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/md_tertiary" />

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/md_unit"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.MedTrack.BodyMedium" />

            </LinearLayout>

            <!--  תאריך תפוגה -->
            <TextView
                style="@style/Widget.MedTrack.FieldLabel"
                android:layout_marginTop="@dimen/md_gutter"
                android:text="@string/intake_expiry_label" />

            <LinearLayout
                android:id="@+id/expiryField"
                android:layout_width="match_parent"
                android:layout_height="@dimen/md_touch_target_min"
                android:background="@drawable/bg_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/md_margin_mobile"
                android:paddingEnd="@dimen/md_margin_mobile">

                <ImageView
                    android:layout_width="@dimen/md_icon_md"
                    android:layout_height="@dimen/md_icon_md"
                    android:contentDescription="@string/cd_calendar"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/md_outline" />

                <TextView
                    android:id="@+id/expiryText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/intake_expiry_hint"
                    android:textAppearance="@style/TextAppearance.MedTrack.BodyLarge"
                    android:textColor="@color/md_on_surface_variant" />

                <TextView
                    android:id="@+id/expiryClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/md_unit"
                    android:paddingEnd="@dimen/md_unit"
                    android:text="@string/cancel"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="16sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!--  כמות -->
            <TextView
                style="@style/Widget.MedTrack.FieldLabel"
                android:layout_marginTop="@dimen/md_gutter"
                android:text="@string/intake_quantity_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/md_touch_target_min"
                android:background="@drawable/bg_input"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/quantityMinus"
                    android:layout_width="@dimen/md_touch_target_min"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_stepper_button"
                    android:contentDescription="@string/cd_decrease"
                    android:padding="@dimen/md_margin_mobile"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/md_on_surface" />

                <EditText
                    android:id="@+id/quantityInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:text="1"
                    android:textColor="@color/md_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/quantityPlus"
                    android:layout_width="@dimen/md_touch_target_min"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_stepper_button"
                    android:contentDescription="@string/cd_increase"
                    android:padding="@dimen/md_margin_mobile"
                    android:src="@drawable/ic_add"
                    app:tint="@color/md_on_surface" />

            </LinearLayout>

            <!--  פרטי אצווה (מתקפל) -->
            <LinearLayout
                android:id="@+id/batchToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_gutter"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/intake_batch_details"
                    android:textAppearance="@style/TextAppearance.MedTrack.LabelLarge"
                    android:textColor="@color/md_on_surface_variant" />

                <ImageView
                    android:id="@+id/batchChevron"
                    android:layout_width="@dimen/md_icon_md"
                    android:layout_height="@dimen/md_icon_md"
                    android:contentDescription="@string/cd_expand"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/md_on_surface_variant" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/batchDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.MedTrack.FieldLabel"
                    android:layout_marginTop="@dimen/md_unit"
                    android:text="@string/intake_batch_number_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/md_touch_target_min"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/md_unit"
                    android:paddingEnd="@dimen/md_unit">

                    <EditText
                        android:id="@+id/batchNumberInput"
                        style="@style/Widget.MedTrack.EditText"
                        android:hint="@string/intake_batch_number_hint"
                        android:importantForAutofill="no" />

                </LinearLayout>

                <TextView
                    style="@style/Widget.MedTrack.FieldLabel"
                    android:layout_marginTop="@dimen/md_margin_mobile"
                    android:text="@string/intake_supplier_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/md_touch_target_min"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/md_unit"
                    android:paddingEnd="@dimen/md_unit">

                    <EditText
                        android:id="@+id/supplierInput"
                        style="@style/Widget.MedTrack.EditText"
                        android:hint="@string/intake_supplier_hint"
                        android:importantForAutofill="no" />

                </LinearLayout>

            </LinearLayout>

            <!--  כפתור קליטה -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitButton"
                style="@style/Widget.MedTrack.Button.Primary"
                android:layout_marginTop="@dimen/md_gutter"
                android:text="@string/intake_submit" />

            <ProgressBar
                android:id="@+id/submitProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/md_margin_mobile"
                android:visibility="gone" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_margin_mobile"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.MedTrack.BodyMedium"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
