<?xml version="1.0" encoding="utf-8"?>
<!--
    עריכת פרטי פריט קיים. נפתח מלחיצה ארוכה על שורה ברשימת המלאי.

    הטופס יושב ב-ScrollView ואין לדיאלוג setMessage: טופס בגובה כזה יחד עם
    הודעה דוחף את סרגל הכפתורים אל מחוץ למסך (ראו dialog_new_item).

    הודעת השגיאה קבועה מעל ה-ScrollView ולא בתוכו - כדי שתהיה גלויה מיד
    כשהשמירה נכשלת, בלי תלות באיפה המשתמשת נמצאת בגלילה של הטופס.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/editItemError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/md_gutter"
        android:paddingTop="@dimen/md_margin_mobile"
        android:paddingEnd="@dimen/md_gutter"
        android:textColor="@color/md_error"
        android:textSize="16sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/md_gutter"
            android:paddingTop="@dimen/md_unit"
            android:paddingEnd="@dimen/md_gutter"
            android:paddingBottom="@dimen/md_unit">

            <TextView
                style="@style/Widget.MedTrack.FieldLabel"
                android:text="@string/new_item_name_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/md_touch_target_min"
                android:layout_marginBottom="@dimen/md_margin_mobile"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/md_unit"
                android:paddingEnd="@dimen/md_unit">

                <EditText
                    android:id="@+id/editItemName"
                    style="@style/Widget.MedTrack.EditText"
                    android:hint="@string/new_item_name_hint"
                    android:importantForAutofill="no" />

            </LinearLayout>

            <TextView
                style="@style/Widget.MedTrack.FieldLabel"
                android:text="@string/new_item_category_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/md_touch_target_min"
                android:layout_marginBottom="@dimen/md_margin_mobile"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/md_unit"
                android:paddingEnd="@dimen/md_unit">

                <EditText
                    android:id="@+id/editItemCategory"
                    style="@style/Widget.MedTrack.EditText"
                    android:hint="@string/new_item_category_hint"
                    android:importantForAutofill="no" />

            </LinearLayout>

            <TextView
                style="@style/Widget.MedTrack.FieldLabel"
                android:text="@string/new_item_unit_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/md_touch_target_min"
                android:layout_marginBottom="@dimen/md_margin_mobile"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/md_unit"
                android:paddingEnd="@dimen/md_unit">

                <EditText
                    android:id="@+id/editItemUnit"
                    style="@style/Widget.MedTrack.EditText"
                    android:hint="@string/new_item_unit_hint"
                    android:importantForAutofill="no" />

            </LinearLayout>

            <TextView
                style="@style/Widget.MedTrack.FieldLabel"
                android:text="@string/new_item_min_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/md_touch_target_min"
                android:layout_marginBottom="@dimen/md_margin_mobile"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/md_unit"
                android:paddingEnd="@dimen/md_unit">

                <EditText
                    android:id="@+id/editItemMinQuantity"
                    style="@style/Widget.MedTrack.EditText"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:selectAllOnFocus="true" />

            </LinearLayout>

            <TextView
                style="@style/Widget.MedTrack.FieldLabel"
                android:text="@string/new_item_barcode_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/md_touch_target_min"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/md_unit"
                android:paddingEnd="@dimen/md_unit">

                <EditText
                    android:id="@+id/editItemBarcode"
                    style="@style/Widget.MedTrack.EditText"
                    android:hint="@string/edit_item_barcode_hint"
                    android:importantForAutofill="no"
                    android:selectAllOnFocus="true"
                    android:textDirection="ltr" />

            </LinearLayout>

            <!-- שינוי כמות בפועל לא נעשה כאן בכוונה - הכמות נגזרת מיומן
                 התנועות ולא נכתבת ישירות, ובלי הרמז הזה אין שום דרך לדעת
                 מהמסך הזה איפה בכלל לתקן אותה. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_margin_mobile"
                android:text="@string/item_edit_quantity_hint"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
