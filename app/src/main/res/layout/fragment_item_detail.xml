<?xml version="1.0" encoding="utf-8"?>
<!--
    כרטיס פריט: תמונת מצב של הפריט, האצוות שיש ממנו במלאי עם תאריכי
    התפוגה שלהן, וכל היסטוריית התנועות שלו.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical">

    <!-- ===================== שורת חזרה ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/md_touch_target_min"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/md_unit"
        android:paddingEnd="@dimen/md_margin_mobile">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/md_primary" />

        <TextView
            android:id="@+id/detailItemName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/md_unit"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.MedTrack.HeadlineMedium" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_outline_variant" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/md_margin_mobile">

            <!-- ===================== תמונת מצב ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/md_gutter">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_current_stock"
                        android:textAppearance="@style/TextAppearance.MedTrack.BodyMedium"
                        android:textColor="@color/md_on_surface_variant" />

                    <TextView
                        android:id="@+id/detailQuantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detailMinQuantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.MedTrack.BodyMedium"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="16sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/detailStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_badge"
                    android:paddingStart="@dimen/md_margin_mobile"
                    android:paddingTop="@dimen/md_unit"
                    android:paddingEnd="@dimen/md_margin_mobile"
                    android:paddingBottom="@dimen/md_unit"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ===================== אצוות ===================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_gutter"
                android:layout_marginBottom="12dp"
                android:text="@string/detail_batches"
                android:textAppearance="@style/TextAppearance.MedTrack.LabelLarge"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/batchesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/batchesEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/md_unit"
                android:paddingBottom="@dimen/md_unit"
                android:text="@string/detail_no_batches"
                android:textAppearance="@style/TextAppearance.MedTrack.BodyMedium"
                android:textColor="@color/md_on_surface_variant"
                android:visibility="gone" />

            <!-- ===================== היסטוריה ===================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_gutter"
                android:layout_marginBottom="12dp"
                android:text="@string/detail_history"
                android:textAppearance="@style/TextAppearance.MedTrack.LabelLarge"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/historyEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/md_unit"
                android:paddingBottom="@dimen/md_unit"
                android:text="@string/detail_no_history"
                android:textAppearance="@style/TextAppearance.MedTrack.BodyMedium"
                android:textColor="@color/md_on_surface_variant"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/detailProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/md_gutter" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
