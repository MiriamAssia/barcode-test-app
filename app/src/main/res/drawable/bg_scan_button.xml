<?xml version="1.0" encoding="utf-8"?>
<!-- כפתור הסריקה הירוק הריבועי שליד שורת החיפוש -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_tertiary_container" />
            <corners android:radius="@dimen/md_radius_xl" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_tertiary" />
            <corners android:radius="@dimen/md_radius_xl" />
        </shape>
    </item>
</selector>
