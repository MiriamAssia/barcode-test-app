<?xml version="1.0" encoding="utf-8"?>
<!-- שורת פריט ברשימת ההוצאה: משנה גוון בלחיצה כדי לתת משוב מיידי למגע  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_container_high" />
            <corners android:radius="@dimen/md_radius_xl" />
            <stroke android:width="1dp" android:color="@color/md_outline_variant" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_container_low" />
            <corners android:radius="@dimen/md_radius_xl" />
            <stroke android:width="1dp" android:color="@color/md_outline_variant" />
        </shape>
    </item>
</selector>
